# Supabase project values. The publishable key is designed for browser use with RLS.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Gemini configuration used by api/generate.js.
# Never prefix the Gemini key with VITE_ in production.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
